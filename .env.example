# Artemis development: tailscale. Hermes deployment: lan.
OLYMPUS_NETWORK_MODE=tailscale
# Bare addresses (no scheme). Used only when the corresponding explicit URL is unset.
APOLLO_LAN_ADDRESS=
APOLLO_TAILSCALE_ADDRESS=
ATHENA_LAN_ADDRESS=
ATHENA_TAILSCALE_ADDRESS=
HERMES_LAN_ADDRESS=

# Explicit server-side endpoints override address-derived URLs; use private routing.
PROXMOX_URL=
PROXMOX_NODE_NAME=apollo
PROXMOX_API_TOKEN_ID=
PROXMOX_API_TOKEN_SECRET=
PROXMOX_CA_FILE=
PROXMOX_ALLOW_SELF_SIGNED=false
PROMETHEUS_URL=
# Optional credentials for an existing private reverse proxy; never use NEXT_PUBLIC_.
PROMETHEUS_BEARER_TOKEN=
LOKI_URL=
LOKI_BEARER_TOKEN=
LOKI_TENANT_ID=

# Each PromQL query must select exactly one host and return one percentage (0–100).
# Leave unset when the relevant exporter or series is unavailable.
PROMETHEUS_APOLLO_CPU_QUERY=
PROMETHEUS_APOLLO_MEMORY_QUERY=
PROMETHEUS_APOLLO_STORAGE_QUERY=
# Athena VM 100: see README for verified Proxmox Exporter query templates.
# Configure storage only after confirming the guest filesystem's identity.
PROMETHEUS_ATHENA_CPU_QUERY=
PROMETHEUS_ATHENA_MEMORY_QUERY=
PROMETHEUS_ATHENA_STORAGE_QUERY=
PROMETHEUS_HERMES_CPU_QUERY=
PROMETHEUS_HERMES_MEMORY_QUERY=
PROMETHEUS_HERMES_STORAGE_QUERY=

# Explicit local file + context. Never put kubeconfig contents in this file.
KUBERNETES_KUBECONFIG=
KUBERNETES_CONTEXT=hermes
# Alternative for the eventual Hermes workload: mounted service-account credentials.
KUBERNETES_IN_CLUSTER=false
